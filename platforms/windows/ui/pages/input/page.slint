// Settings → "Kiểu gõ": stacked glass rows (control under label, not side-by-side).

import { Palette } from "std-widgets.slint";
import { Theme, Card, Segmented } from "../../theme/mod.slint";
import { MethodSelector } from "method_selector.slint";

export component InputPage inherits VerticalLayout {
    in property <string> method;
    in property <string> tone-style;
    callback pick-method(string);
    callback pick-tone(string);

    spacing: Theme.sp-md;
    Text {
        text: "Kiểu gõ";
        font-size: Theme.font-title;
        font-weight: 700;
        color: Palette.foreground;
    }
    Text {
        text: "Chọn cách gõ và quy tắc đặt dấu.";
        font-size: Theme.font-caption;
        color: Theme.subtle;
    }
    Card {
        Text {
            text: "Phương thức";
            font-size: Theme.font-body;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: root.method == "telex_advanced"
                ? "Full Telex — [→ư, ]→ơ, w đầu từ→ư"
                : (root.method == "telex"
                    ? "Dấu bằng chữ cái — aa→â, ow→ơ, as→á, dd→đ"
                    : "Dấu bằng chữ số — a6→â, o7→ơ, a1→á, d9→đ");
            font-size: Theme.font-caption;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        MethodSelector {
            method: root.method;
            picked(value) => { root.pick-method(value); }
        }
    }
    Card {
        Text {
            text: "Kiểu đặt dấu";
            font-size: Theme.font-body;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: root.tone-style == "modern"
                ? "Dấu kiểu mới — hoà, khoẻ, thuý"
                : "Dấu kiểu cũ — hòa, khỏe, thúy";
            font-size: Theme.font-caption;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        Segmented {
            options: [{ id: "traditional", label: "Truyền thống" }, { id: "modern", label: "Hiện đại" }];
            current: root.tone-style;
            changed(v) => { root.pick-tone(v); }
        }
    }
}
