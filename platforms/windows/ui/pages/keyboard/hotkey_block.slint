// One hotkey block: section label + segmented + live keycaps (no card chrome).

import { Theme, Section, Segmented, KeyCap, SegOption } from "../../theme/mod.slint";

export component HotkeyBlock inherits VerticalLayout {
    in property <string> heading;
    in property <string> subtitle;
    in property <[SegOption]> options;
    in property <string> current;
    in property <[string]> caps;
    in property <bool> conflict;
    callback changed(string);

    spacing: Theme.sp-sm;
    width: 100%;

    Section {
        title: root.heading;
        Text {
            text: root.subtitle;
            font-size: Theme.font-caption;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        Segmented {
            options: root.options;
            current: root.current;
            changed(v) => { root.changed(v); }
        }
        HorizontalLayout {
            spacing: Theme.sp-sm;
            Text {
                text: "Đang dùng";
                font-size: Theme.font-caption;
                font-weight: 600;
                color: Theme.subtle;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: Theme.sp-xs;
                for cap in root.caps: KeyCap { label: cap; }
            }
        }
        if root.conflict: Text {
            text: "Trùng phím tắt hệ thống — Windows có thể xử lý song song.";
            font-size: Theme.font-caption;
            color: Theme.warn;
            wrap: word-wrap;
        }
    }
}
