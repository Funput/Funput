// Settings → "Tổng quan": brand hero, VI toggle, quick method, launch-at-login.

import { Theme, Section, Row, AccentSwitch, Segmented } from "../../theme/mod.slint";
import { OverviewHero } from "hero.slint";

export component OverviewPage inherits VerticalLayout {
    in property <string> method;
    in-out property <bool> vi-enabled;
    in-out property <bool> launch-at-login;
    in-out property <bool> auto-english-layout;
    callback set-enabled(bool);
    callback set-auto-english-layout(bool);
    callback set-launch(bool);
    callback pick-method(string);

    spacing: Theme.sp-lg;
    width: 100%;
    alignment: start;

    OverviewHero { }

    Section {
        title: "Chế độ gõ";
        Row {
            title: "Gõ tiếng Việt";
            subtitle: root.vi-enabled
                ? "Funput đang xử lý phím gõ."
                : "Đang dùng bàn phím gốc.";
            icon: @image-url("../../icons/nav/primary/switch.svg");
            Segmented {
                options: [
                    { id: "en", label: "EN" },
                    { id: "vi", label: "VI" },
                ];
                current: root.vi-enabled ? "vi" : "en";
                changed(value) => {
                    root.vi-enabled = value == "vi";
                    root.set-enabled(root.vi-enabled);
                }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        Row {
            title: "Phương thức";
            subtitle: "Telex, Telex nâng cao hoặc VNI.";
            icon: @image-url("../../icons/nav/primary/keyboard.svg");
            Segmented {
                options: [
                    { id: "telex", label: "Telex" },
                    { id: "telex_advanced", label: "Telex+" },
                    { id: "vni", label: "VNI" },
                ];
                current: root.method;
                changed(value) => { root.pick-method(value); }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        Row {
            title: "Tự tắt khi đổi bàn phím";
            subtitle: "Chuyển sang EN khi dùng bàn phím tiếng Nhật, Hàn, Trung…";
            icon: @image-url("../../icons/nav/primary/keyboard.svg");
            AccentSwitch {
                checked <=> root.auto-english-layout;
                toggled => { root.set-auto-english-layout(self.checked); }
            }
        }
    }

    Section {
        title: "Hệ thống";
        Row {
            title: "Khởi động cùng Windows";
            subtitle: "Tự chạy Funput mỗi khi đăng nhập.";
            icon: @image-url("../../icons/status/power.svg");
            AccentSwitch {
                checked <=> root.launch-at-login;
                toggled => { root.set-launch(self.checked); }
            }
        }
    }
}
