// Settings → "Tổng quan": brand hero, launch-at-login, config backup.

import { Theme, Section, Row, AccentSwitch, Segmented, PrimaryButton, GhostButton } from "../../theme/mod.slint";
import { OverviewHero } from "hero.slint";

export component OverviewPage inherits VerticalLayout {
    in-out property <bool> vi-enabled;
    in-out property <bool> launch-at-login;
    callback set-enabled(bool);
    callback set-launch(bool);
    callback export-config();
    callback import-config();

    spacing: Theme.sp-lg;
    width: 100%;
    alignment: start;

    OverviewHero { }

    Section {
        title: "Chế độ gõ";
        Row {
            title: "Gõ tiếng Việt";
            subtitle: root.vi-enabled
                ? "Funput đang xử lý phím gõ."
                : "Đang dùng bàn phím gốc.";
            icon: @image-url("../../icons/nav/primary/switch.svg");
            Segmented {
                options: [
                    { id: "en", label: "EN" },
                    { id: "vi", label: "VI" },
                ];
                current: root.vi-enabled ? "vi" : "en";
                changed(value) => { root.set-enabled(value == "vi"); }
            }
        }
    }

    Section {
        title: "Hệ thống";
        Row {
            title: "Khởi động cùng Windows";
            subtitle: "Tự chạy Funput mỗi khi đăng nhập.";
            icon: @image-url("../../icons/status/power.svg");
            AccentSwitch {
                checked <=> root.launch-at-login;
                toggled => { root.set-launch(self.checked); }
            }
        }
    }

    Section {
        title: "Sao lưu";
        Row {
            title: "Xuất cấu hình";
            subtitle: "Lưu tuỳ chọn và gõ tắt ra tệp.";
            icon: @image-url("../../icons/status/backup.svg");
            GhostButton {
                text: "Xuất…";
                clicked => { root.export-config(); }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        Row {
            title: "Nhập cấu hình";
            subtitle: "Gộp tuỳ chọn và gõ tắt từ tệp.";
            icon: @image-url("../../icons/status/backup.svg");
            PrimaryButton {
                text: "Nhập…";
                clicked => { root.import-config(); }
            }
        }
    }
}
