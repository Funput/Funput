// Overview hero: brand and tagline only — no controls (sidebar already labels).

import { Palette } from "std-widgets.slint";
import { Theme } from "../../theme/mod.slint";

export component OverviewHero inherits HorizontalLayout {
    spacing: Theme.sp-md;
    width: 100%;
    alignment: start;

    Image {
        source: @image-url("../../../../../assets/logo.png");
        width: 68px;
        height: 68px;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 6px;
        Text {
            text: "Funput";
            font-size: 28px;
            font-weight: 700;
            color: Palette.foreground;
        }
        Text {
            text: "Gõ tiếng Việt ở mọi ứng dụng trên Windows.";
            font-size: Theme.font-body;
            color: Theme.subtle;
            wrap: word-wrap;
        }
    }
}
