// About update block: status line + Primary/Ghost actions by update-state.

import { Theme, Section, PrimaryButton, GhostButton } from "../../theme/mod.slint";

export component AboutUpdate inherits Section {
    in property <string> update-state: "idle";
    in property <string> update-version;
    in property <string> update-message;
    callback check-update();
    callback install-update();
    callback relaunch-now();
    callback open-changelog();

    title: "Cập nhật";

    if root.update-state != "idle": Text {
        text: root.update-state == "checking" ? "Đang kiểm tra…"
            : root.update-state == "uptodate" ? "Bạn đang dùng bản mới nhất."
            : root.update-state == "available" ? "Có bản mới \{root.update-version}."
            : root.update-state == "downloading" ? "Đang tải bản cập nhật…"
            : root.update-state == "ready" ? "Đã cập nhật Funput. Khởi động lại để áp dụng."
            : root.update-message;
        font-size: Theme.font-caption;
        wrap: word-wrap;
        color: root.update-state == "error" ? Theme.danger : Theme.subtle;
    }

    HorizontalLayout {
        spacing: Theme.sp-sm;
        alignment: start;
        if root.update-state != "available"
            && root.update-state != "downloading"
            && root.update-state != "ready": PrimaryButton {
            text: "Kiểm tra cập nhật…";
            enabled: root.update-state != "checking";
            clicked => { root.check-update(); }
        }
        if root.update-state == "available" || root.update-state == "downloading": PrimaryButton {
            text: "Tải và cài đặt";
            enabled: root.update-state != "downloading";
            clicked => { root.install-update(); }
        }
        if root.update-state == "available": GhostButton {
            text: "Xem thay đổi";
            clicked => { root.open-changelog(); }
        }
        if root.update-state == "ready": PrimaryButton {
            text: "Khởi động lại";
            clicked => { root.relaunch-now(); }
        }
    }
}
