// Win11 NavigationView: items sit directly on the backdrop. The selected item gets a
// subtle fill plus a 3px accent indicator bar — foreground text/icon stay neutral.

import { Palette } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";

export component Sidebar inherits Rectangle {
    in-out property <string> active;
    width: 208px;
    background: transparent;

    property <[{id: string, label: string, icon: image}]> nav: [
        { id: "input", label: "Kiểu gõ", icon: @image-url("../icons/nav/primary/keyboard.svg") },
        { id: "keyboard", label: "Phím chuyển", icon: @image-url("../icons/nav/primary/switch.svg") },
        { id: "smart", label: "Thông minh", icon: @image-url("../icons/nav/primary/sparkles.svg") },
        { id: "shortcuts", label: "Gõ tắt", icon: @image-url("../icons/nav/primary/shortcut.svg") },
        { id: "apps", label: "Ứng dụng", icon: @image-url("../icons/nav/primary/apps.svg") },
        { id: "general", label: "Chung", icon: @image-url("../icons/nav/secondary/settings.svg") },
        { id: "about", label: "Giới thiệu", icon: @image-url("../icons/nav/secondary/info.svg") },
    ];

    VerticalLayout {
        padding: Theme.sp-sm;
        padding-top: Theme.sp-md;
        spacing: 2px;
        alignment: start;

        VerticalLayout {
            padding-left: 12px;
            padding-bottom: Theme.sp-sm;
            Text {
                text: "Funput";
                font-size: 18px;
                font-weight: 700;
                color: Palette.foreground;
            }
            Text {
                text: "Cài đặt";
                font-size: Theme.font-caption;
                color: Theme.subtle;
            }
        }

        for item in root.nav: Rectangle {
            height: 40px;
            border-radius: Theme.r-control;
            background: root.active == item.id
                ? Theme.nav-active
                : (nav-touch.has-hover ? Theme.nav-hover : transparent);
            animate background { duration: 120ms; easing: ease-out; }

            // Accent selection indicator — 3x16 pill flush to the left edge.
            Rectangle {
                x: 0;
                width: 3px;
                height: root.active == item.id ? 16px : 0px;
                border-radius: 1.5px;
                background: Theme.accent;
                animate height { duration: 140ms; easing: ease-in-out; }
            }

            HorizontalLayout {
                padding-left: 12px;
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: item.icon;
                        colorize: Palette.foreground;
                        width: 16px;
                        height: 16px;
                    }
                }
                Text {
                    text: item.label;
                    vertical-alignment: center;
                    font-size: 14px;
                    font-weight: root.active == item.id ? 600 : 400;
                    color: Palette.foreground;
                }
            }
            nav-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.active = item.id; }
            }
        }
    }
}
