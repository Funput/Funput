// Settings → "Chung": general preferences (launch at login) + config backup.

import { Palette, Switch, Button } from "std-widgets.slint";
import { Theme, Card, Row } from "theme.slint";

export component GeneralPage inherits VerticalLayout {
    in-out property <bool> launch-at-login;
    callback set-launch(bool);
    callback export-config();
    callback import-config();

    spacing: Theme.sp-md;
    Text { text: "Chung"; font-size: 20px; font-weight: 700; color: Palette.foreground; }
    Card {
        Row {
            title: "Khởi động cùng Windows";
            subtitle: "Tự chạy Funput mỗi khi đăng nhập.";
            Switch {
                checked <=> root.launch-at-login;
                toggled => { root.set-launch(self.checked); }
            }
        }
    }

    Text { text: "Sao lưu & khôi phục"; font-size: 20px; font-weight: 700; color: Palette.foreground; }
    Card {
        Row {
            title: "Xuất cấu hình";
            subtitle: "Lưu gõ tắt và tuỳ chọn ra tệp .json.";
            Button {
                text: "Xuất…";
                clicked => { root.export-config(); }
            }
        }
        Row {
            title: "Nhập cấu hình";
            subtitle: "Gộp gõ tắt và áp tuỳ chọn từ tệp .json.";
            Button {
                text: "Nhập…";
                clicked => { root.import-config(); }
            }
        }
    }
}
