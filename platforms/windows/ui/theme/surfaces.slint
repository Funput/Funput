// Fluent card: a flat semi-opaque layer over the backdrop, delineated by a hairline
// stroke rather than a shadow (Win11 cards are not elevated).

import { Theme } from "tokens.slint";

export component Card inherits Rectangle {
    border-radius: Theme.r-card;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: Theme.sp-lg;
        spacing: Theme.sp-md;
        @children
    }
}
