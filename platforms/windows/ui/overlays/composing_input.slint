// Single-line field that composes Vietnamese via the Compose global, at the caret.
//
// The caret and anchor offsets are TextInput properties Slint marks internal; they
// exist in the pinned 1.17.1. Re-check them when upgrading Slint.

import { Palette } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Compose, FieldEdit } from "compose.slint";

export component ComposingInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);

    height: 32px;
    border-radius: Theme.r-control;
    background: Theme.field-bg;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.card-border;
    animate border-color { duration: 150ms; easing: ease-out; }

    ph := Text {
        x: 10px;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.subtle;
        visible: root.text == "";
    }

    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        color: Palette.foreground;

        // Show what the composer made of the key, caret right after the composed text.
        function show(edit: FieldEdit) {
            self.text = edit.text;
            self.set-selection-offsets(edit.cursor, edit.cursor);
            root.edited(self.text);
        }

        changed has-focus => {
            if self.has-focus {
                Compose.reset();
            }
        }
        edited => { root.edited(self.text); }
        key-pressed(event) => {
            if event.modifiers.control && !event.modifiers.alt {
                if event.text == "a" || event.text == "\u{1}" {
                    self.select-all();
                    return accept;
                }
                if event.text == "c" || event.text == "\u{3}" {
                    self.copy();
                    return accept;
                }
                if event.text == "x" || event.text == "\u{18}" {
                    self.cut();
                    Compose.reset();
                    root.edited(self.text);
                    return accept;
                }
                if event.text == "v" || event.text == "\u{16}" {
                    self.paste();
                    Compose.reset();
                    root.edited(self.text);
                    return accept;
                }
                if event.text == "z" || event.text == "\u{1a}" {
                    self.undo();
                    Compose.reset();
                    root.edited(self.text);
                    return accept;
                }
                if event.text == "y" || event.text == "\u{19}" {
                    self.redo();
                    Compose.reset();
                    root.edited(self.text);
                    return accept;
                }
                return reject;
            }
            if event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Backspace {
                self.show(Compose.backspace(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset));
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.Home || event.text == Key.End
                || event.text == Key.Return || event.text == Key.Tab
                || event.text == Key.Escape || event.text == Key.Delete {
                Compose.reset();
                return reject;
            }
            let edit = Compose.key(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset, event.text);
            if !edit.accepted {
                return reject;
            }
            self.show(edit);
            return accept;
        }
    }
}
