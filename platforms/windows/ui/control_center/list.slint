// Hairline rows + footer action for the Control Center.

import { Palette } from "std-widgets.slint";
import { Theme, GhostButton } from "../theme/mod.slint";

component LinkRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked;
    height: 34px;
    HorizontalLayout {
        spacing: Theme.sp-sm;
        Text {
            text: root.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: 13px;
            color: Palette.foreground;
        }
        Text {
            text: root.value;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: "›";
            vertical-alignment: center;
            font-size: 16px;
            color: Theme.subtle;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CcList {
    in property <string> hotkey-label;
    in property <string> tone-label;
    callback open-keyboard();
    callback cycle-tone();
    callback open-settings();

    width: 100%;
    VerticalLayout {
        spacing: Theme.sp-sm;
        width: 100%;
        Rectangle {
            width: 100%;
            border-radius: Theme.r-shell;
            background: Theme.flyout-card;
            border-width: 1px;
            border-color: Theme.flyout-border;
            VerticalLayout {
                padding-left: Theme.sp-ms;
                padding-right: Theme.sp-ms;
                padding-top: Theme.sp-xs;
                padding-bottom: Theme.sp-xs;
                LinkRow {
                    label: "Phím chuyển";
                    value: root.hotkey-label;
                    clicked => { root.open-keyboard(); }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                LinkRow {
                    label: "Kiểu đặt dấu";
                    value: root.tone-label;
                    clicked => { root.cycle-tone(); }
                }
            }
        }
        GhostButton {
            text: "Mở cài đặt đầy đủ";
            clicked => { root.open-settings(); }
        }
    }
}
