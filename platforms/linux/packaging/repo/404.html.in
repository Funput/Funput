<!DOCTYPE html>
<!-- 404 page for the Funput Linux package repository.
     @REPO_URL@ is substituted by the publish-repo workflow with the Pages base URL.

     GitHub Pages serves no directory listings, so a path like /deb/ or a typo in
     a package name lands here. Same design as index.html.in — keep the two in
     sync when either changes. -->
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Không tìm thấy — kho phần mềm Funput</title>
<meta name="robots" content="noindex">
<style>
  :root {
    color-scheme: light dark;
    --bg: #fbfbfd; --fg: #1d1d1f; --muted: #6e6e73; --line: #e6e6eb;
    --btn-fg: #fff; --glow: .28;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0f; --fg: #f5f5f7; --muted: #9a9aa2; --line: #2a2a31;
      --glow: .38;
    }
  }

  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    display: grid; place-items: center;
    padding: 2rem 1.25rem;
    overflow-x: hidden;
  }

  .glow { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .glow i {
    position: absolute; display: block; border-radius: 50%;
    filter: blur(90px); opacity: var(--glow);
  }
  .glow .a {
    width: 46vmax; height: 46vmax; top: -16vmax; left: -12vmax;
    background: radial-gradient(circle, #FFA43F, #F600A5 60%, transparent 72%);
    animation: drift-a 28s ease-in-out infinite alternate;
  }
  .glow .b {
    width: 42vmax; height: 42vmax; bottom: -18vmax; right: -14vmax;
    background: radial-gradient(circle, #25D9F6, #9F00EE 62%, transparent 74%);
    animation: drift-b 34s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(6vmax, 5vmax, 0) scale(1.15); }
  }
  @keyframes drift-b {
    from { transform: translate3d(0, 0, 0) scale(1.1); }
    to   { transform: translate3d(-7vmax, -4vmax, 0) scale(1); }
  }

  main {
    position: relative; z-index: 1;
    max-width: 34rem; text-align: center;
  }

  .mark { width: 92px; height: 92px; display: block; margin: 0 auto 1.5rem; }
  .mark path { transform-box: fill-box; }
  .spine {
    opacity: 0; transform-origin: 50% 0%;
    animation: spine-in .55s cubic-bezier(.22, 1, .36, 1) forwards;
  }
  .leaf {
    opacity: 0; transform-origin: 0% 50%;
    animation: leaf-in .7s cubic-bezier(.22, 1, .36, 1) forwards;
  }
  .leaf-1 { animation-delay: .26s; }
  .leaf-2 { animation-delay: .37s; }
  .leaf-3 { animation-delay: .48s; }
  @keyframes spine-in {
    from { opacity: 0; transform: scaleY(.6); }
    to   { opacity: 1; transform: scaleY(1); }
  }
  @keyframes leaf-in {
    from { opacity: 0; transform: rotate(-8deg) scale(.94); }
    to   { opacity: 1; transform: rotate(0) scale(1); }
  }

  .fade { opacity: 0; animation: fade-up .6s ease-out forwards; }
  .d1 { animation-delay: .60s; }
  .d2 { animation-delay: .70s; }
  .d3 { animation-delay: .80s; }
  .d4 { animation-delay: .92s; }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  .code {
    display: block; font-size: .8rem; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--muted); margin-bottom: .5rem;
  }
  h1 { font-size: 1.7rem; margin: 0 0 .6rem; letter-spacing: -.022em; }
  p  { margin: 0 auto; color: var(--muted); max-width: 30rem; }

  .btn {
    display: inline-block; margin-top: 1.9rem;
    padding: .8rem 1.6rem; border-radius: 999px;
    font-size: 1rem; font-weight: 600; text-decoration: none; color: var(--btn-fg);
    background: linear-gradient(115deg, #FF5C73, #F600A5 55%, #9F00EE);
    box-shadow: 0 10px 26px -12px #F600A5;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .btn:hover, .btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -12px #F600A5;
  }

  .alt { display: block; margin-top: .9rem; font-size: .9rem; }
  .alt a { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); }
  .alt a:hover { color: var(--fg); }

  footer {
    margin-top: 3rem; padding-top: 1.1rem; border-top: 1px solid var(--line);
    font-size: .82rem; color: var(--muted);
  }
  footer a { color: inherit; }

  @media (max-width: 400px) {
    h1 { font-size: 1.45rem; }
    .mark { width: 76px; height: 76px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow i, .mark path, .fade { animation: none !important; }
    .mark path, .fade { opacity: 1; transform: none; }
    .btn { transition: none; }
  }
</style>
</head>
<body>

<div class="glow" aria-hidden="true"><i class="a"></i><i class="b"></i></div>

<main>
  <svg class="mark" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Funput">
    <defs>
      <linearGradient id="funput-top" x1="272" y1="210" x2="862" y2="327" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FFA43F"/>
        <stop offset="0.48" stop-color="#FF5C73"/>
        <stop offset="1" stop-color="#F600A5"/>
      </linearGradient>
      <radialGradient id="funput-middle" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
        gradientTransform="translate(542 518) rotate(7) scale(390 265)">
        <stop offset="0" stop-color="#D92BFF"/>
        <stop offset="0.55" stop-color="#B600F1"/>
        <stop offset="1" stop-color="#5600D8"/>
      </radialGradient>
      <linearGradient id="funput-bottom" x1="275" y1="724" x2="548" y2="793" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#1E72FF"/>
        <stop offset="1" stop-color="#25D9F6"/>
      </linearGradient>
      <linearGradient id="funput-spine" x1="261" y1="152" x2="261" y2="897" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FFA43F"/>
        <stop offset="0.33" stop-color="#FF4F78"/>
        <stop offset="0.62" stop-color="#9F00EE"/>
        <stop offset="1" stop-color="#1F78FF"/>
      </linearGradient>
    </defs>
    <path class="spine" fill="url(#funput-spine)"
      d="M261 356C261 239 355 144 472 144H514C392 159 311 245 311 356V846C311 867 302 887 286 901C280 906 271 906 266 900C263 897 261 892 261 887V356Z"/>
    <path class="leaf leaf-1" fill="url(#funput-top)"
      d="M261 548V356C261 239 355 144 472 144H856C861 144 864 148 863 153C856 249 817 313 759 346C725 366 686 362 641 362H496C391 362 303 437 261 548Z"/>
    <path class="leaf leaf-2" fill="url(#funput-middle)"
      d="M261 743V548C261 444 362 362 496 362H725C728 362 730 365 730 368C728 456 697 523 641 558C599 585 555 572 500 572H458C366 572 291 638 261 743Z"/>
    <path class="leaf leaf-3" fill="url(#funput-bottom)"
      d="M261 887V743C261 642 346 572 458 572H541C545 572 548 575 547 579C539 670 502 747 436 794C401 819 360 828 323 839C295 847 278 867 266 895C264 900 261 897 261 887Z"/>
  </svg>

  <span class="code fade d1">404</span>
  <h1 class="fade d1">Không có gì ở đường dẫn này</h1>

  <p class="fade d2">
    Địa chỉ này phục vụ kho <b>apt</b>, <b>dnf</b>, <b>zypper</b> và <b>pacman</b> của Funput.
    Các thư mục của kho không duyệt bằng trình duyệt được — package manager mới đọc chúng.
  </p>

  <a class="btn fade d3" href="@REPO_URL@">Về trang chủ kho</a>

  <span class="alt fade d4">
    <a href="https://docs.funput.app/docs/install/linux">Hướng dẫn cài đặt</a>
  </span>

  <footer class="fade d4">
    Khóa ký công khai: <a href="@REPO_URL@funput.asc">funput.asc</a> ·
    Mã nguồn: <a href="https://github.com/Funput/Funput">github.com/Funput/Funput</a>
  </footer>
</main>

</body>
</html>
