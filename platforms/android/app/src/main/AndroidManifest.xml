<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The news tab reads the funput.app blog feed, and syncing between devices will need the
         network too. The keyboard itself never calls the network. Declared here, in the app's own
         manifest, so it outranks the removal :ime applies to what ML Kit declares. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Enter key page lists the launcher's apps to choose from. Asking for the launcher
         intent alone keeps every other installed package out of view. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Funput">
        <activity
            android:name=".speech.SpeechSetupActivity"
            android:exported="false"
            android:enabled="@bool/speech_feature_available"
            android:theme="@style/Theme.Funput" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Funput.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
