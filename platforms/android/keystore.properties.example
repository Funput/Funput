# Copy this file to keystore.properties (git-ignored) and fill in your upload key.
# Never commit keystore.properties or the .jks/.keystore file — this is an open-source repo.
#
#   cp keystore.properties.example keystore.properties
#
# storeFile is resolved relative to platforms/android/ (the Gradle root).

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
